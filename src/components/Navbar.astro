---
import { languages } from '../i18n/translations';

interface Props {
  currentLang: 'fr' | 'en' | 'de';
  t: (key: string) => string;
}

const { currentLang, t } = Astro.props;

const getLangUrl = (lang: string) => {
  if (lang === 'fr') return '/';
  return `/${lang}`;
};
---

<header class="header">
  <div class="container header-inner">
    <a href={getLangUrl(currentLang)} class="brand" aria-label="Nakôbio Accueil">
      <img src="/nakobio-logo.svg" alt="Nakôbio" class="brand-logo" />
    </a>

    <nav class="nav" aria-label="Navigation principale">
      <a href="#vision" class="nav-link">{t('nav.vision')}</a>
      <a href="#actions" class="nav-link">{t('nav.actions')}</a>
      <a href="#galerie" class="nav-link">{t('nav.gallery')}</a>
      <a href="https://campus.nako.bio" target="_blank" rel="noopener noreferrer" class="nav-link nav-link-campus">
        {t('nav.campus')}
      </a>
    </nav>

    <div class="header-actions">
      <!-- Sélecteur de langue épuré -->
      <div class="lang-picker">
        {Object.entries(languages).map(([code, label]) => (
          <a
            href={getLangUrl(code)}
            class:list={['lang-btn', { active: currentLang === code }]}
            title={label}
          >
            {code.toUpperCase()}
          </a>
        ))}
      </div>

      <!-- Menu toggle mobile -->
      <button class="menu-toggle" aria-label="Menu" id="menu-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobile-drawer">
    <div class="mobile-drawer-inner">
      <nav class="mobile-nav">
        <a href="#vision" class="mobile-link">{t('nav.vision')}</a>
        <a href="#actions" class="mobile-link">{t('nav.actions')}</a>
        <a href="#galerie" class="mobile-link">{t('nav.gallery')}</a>
        <a href="https://campus.nako.bio" target="_blank" rel="noopener noreferrer" class="mobile-link campus-link">
          {t('nav.campus')}
        </a>
      </nav>
      <div class="mobile-lang-wrap">
        <div class="lang-picker">
          {Object.entries(languages).map(([code, label]) => (
            <a
              href={getLangUrl(code)}
              class:list={['lang-btn', { active: currentLang === code }]}
            >
              {code.toUpperCase()}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const links = drawer?.querySelectorAll('.mobile-link');

  btn?.addEventListener('click', () => {
    drawer?.classList.toggle('open');
  });

  links?.forEach(link => {
    link.addEventListener('click', () => {
      drawer?.classList.remove('open');
    });
  });
</script>

<style>
  .header {
    background-color: rgba(255, 253, 246, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-logo {
    height: 38px;
    width: auto;
  }

  .nav {
    display: none;
    align-items: center;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .nav {
      display: flex;
    }
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-brand-secondary);
  }

  .nav-link-campus {
    color: var(--color-brand-primary);
    font-weight: var(--weight-bold);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .lang-picker {
    display: inline-flex;
    background: rgba(27, 35, 24, 0.05);
    padding: 2px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
  }

  .lang-btn {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: var(--weight-bold);
    padding: 3px 8px;
    border-radius: var(--radius-full);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .lang-btn.active {
    background: #FFFFFF;
    color: var(--color-brand-primary);
    box-shadow: 0 1px 2px rgba(0,0,0,0.06);
  }

  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--color-ink);
    cursor: pointer;
    padding: 0.5rem;
  }

  @media (min-width: 768px) {
    .menu-toggle {
      display: none;
    }
  }

  .mobile-drawer {
    display: none;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 1.5rem 0;
  }

  .mobile-drawer.open {
    display: block;
  }

  .mobile-drawer-inner {
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-link {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    text-decoration: none;
  }

  .mobile-link.campus-link {
    color: var(--color-brand-primary);
    font-weight: var(--weight-bold);
  }

  .mobile-lang-wrap {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
</style>
