---
interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<section id="soutenir" class="support-section section-padding">
  <div class="container">
    <div class="support-card">
      <div class="support-grid">
        <div class="support-content">
          <span class="eyebrow eyebrow-light">
            <span class="eyebrow-dot"></span>
            {t('support.eyebrow')}
          </span>

          <h2 class="support-title">{t('support.title')}</h2>

          <p class="support-desc">{t('support.desc')}</p>
          <p class="support-sub">{t('support.docs')}</p>

          <div class="support-actions">
            <a 
              href="https://donorbox.org/nakobio/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-accent btn-lg"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
              {t('support.btn_donate')}
            </a>

            <a 
              href="https://t.me/nakobio_intensif/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-outline-white btn-lg"
            >
              {t('support.btn_telegram')}
            </a>

            <a 
              href="https://chat.whatsapp.com/DNqsiZHqQ6h9w1RKuTO4US" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-outline-white btn-lg"
            >
              {t('support.btn_whatsapp')}
            </a>
          </div>
        </div>

        <div class="support-visual">
          <div class="visual-wrap">
            <img src="/images/cta-donate.png" alt="Soutenir Nakôbio" class="support-image" loading="lazy" />
            <div class="visual-badge">
              <span class="badge-num">100%</span>
              <span class="badge-lbl">investi sur le terrain au Mali</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .support-section {
    background-color: var(--color-surface);
  }

  .support-card {
    background: linear-gradient(135deg, #1E3324 0%, #2F4A34 100%);
    border-radius: var(--radius-xl, 24px);
    padding: clamp(2.5rem, 5vw, 4.5rem);
    color: #FFFFFF;
    box-shadow: var(--shadow-xl);
    position: relative;
    overflow: hidden;
  }

  .support-card::after {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(224, 160, 48, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .support-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 900px) {
    .support-grid {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .eyebrow-light {
    background: rgba(255, 255, 255, 0.15);
    color: var(--color-brand-accent-light);
  }

  .eyebrow-light .eyebrow-dot {
    background-color: var(--color-brand-accent-light);
  }

  .support-title {
    color: #FFFFFF;
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 1.25rem;
  }

  .support-desc {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 1rem;
  }

  .support-sub {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 2rem;
  }

  .support-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .support-visual {
    display: flex;
    justify-content: center;
  }

  .visual-wrap {
    position: relative;
    max-width: 380px;
    width: 100%;
  }

  .support-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 36px rgba(0,0,0,0.3);
  }

  .visual-badge {
    position: absolute;
    bottom: -1rem;
    left: -1rem;
    background: rgba(255, 253, 246, 0.96);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
  }

  .badge-num {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-brand-secondary);
    line-height: 1;
  }

  .badge-lbl {
    font-size: 0.75rem;
    font-weight: var(--weight-bold);
    color: var(--color-ink);
  }
</style>
